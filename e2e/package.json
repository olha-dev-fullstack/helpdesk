{
  "name": "e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose -f ../docker-compose.yml up -d --wait db-test",
    "db:down": "docker compose -f ../docker-compose.yml rm -sfv db-test",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4"
  }
}
